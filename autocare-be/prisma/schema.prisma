generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  password    String?
  firebaseUid String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles           Vehicle[]
  documents          Document[]
  passwordResetCodes PasswordResetCode[]
}

model Vehicle {
  id                   String   @id @default(uuid())
  name                 String
  registrationNumber   String
  vehicleType          String
  brand                String
  model                String
  year                 Int
  mileage              Int      @default(0)
  licenseExpiry        DateTime?
  insuranceExpiry      DateTime?
  emissionTestExpiry   DateTime?
  serviceReminderDate  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  maintenanceRecords MaintenanceRecord[]
  documents          Document[]

  @@index([userId])
}

model MaintenanceRecord {
  id          String   @id @default(uuid())
  serviceType String
  serviceDate DateTime
  mileage     Int
  cost        Float
  notes       String?
  createdAt   DateTime @default(now())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// A photographed/uploaded document (insurance card, registration, etc.) for a vehicle.
// fileData holds the image as a base64 data URI, stored directly in Postgres — this keeps
// the feature working with zero extra infrastructure (no S3/Cloudinary account needed) and,
// unlike saving to the API's local disk, survives fine on a serverless host like Vercel.
// If storage cost or size becomes a problem later, swap fileData for a fileUrl pointing at
// real object storage without changing the rest of the model.
model Document {
  id               String    @id @default(uuid())
  type             String // INSURANCE | LICENSE | REGISTRATION | EMISSION | OTHER
  fileData         String // base64 data URI of the captured/uploaded image
  mimeType         String
  extractedExpiry  DateTime? // filled in by the OCR step (currently a stub — see src/utils/ocr.ts)
  extractedIssuer  String?
  referenceNumber  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([userId])
}

// A one-time, short-lived code emailed to a user who is resetting their password.
// Only the bcrypt hash of the code is stored, so a database leak does not hand an
// attacker working reset codes. Rows are deleted whenever a fresh code is issued.
model PasswordResetCode {
  id         String    @id @default(uuid())
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
