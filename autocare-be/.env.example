DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autocare?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000

# Firebase Admin SDK (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-actual-key\n-----END PRIVATE KEY-----\n"
