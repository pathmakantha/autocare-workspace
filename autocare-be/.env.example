DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autocare?schema=public"
# Prisma's directUrl for migrations — Neon/Vercel Postgres provide a separate pooled
# vs unpooled connection string; local Postgres has no pooler, so these are the same.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/autocare?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000

# Firebase Admin SDK (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-actual-key\n-----END PRIVATE KEY-----\n"

# SMTP for password-reset emails. With these unset the reset flow still works end to end
# but logs the code to the server console instead of emailing it (and says so) - it never
# silently pretends to have sent mail.
# For Gmail: create an App Password (Google Account > Security > 2-Step Verification >
# App passwords) and use it as SMTP_PASS - your normal account password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="AutoCare <you@gmail.com>"
